{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recipe with provenance",
  "type": "object",
  "required": [
    "id",
    "name",
    "servings",
    "ingredients",
    "allergens",
    "compositionComplete",
    "steps"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "servings": {
      "type": "integer",
      "minimum": 1
    },
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "productId",
          "grams",
          "basis"
        ],
        "properties": {
          "productId": {
            "type": "string"
          },
          "grams": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "basis": {
            "enum": [
              "raw",
              "cooked"
            ]
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "allergens": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "compositionComplete": {
      "type": "boolean"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "nutritionSource": {
      "type": "string"
    }
  }
}
